{
  "schema": 1,
  "name": "wordpress",
  "version": "1.0.0",
  "taskrailCompatibility": "3.0.x",
  "description": "Reusable WordPress REST API integration for posts, pages, media and site data.",
  "purpose": "Canonical WordPress REST technical integration across TaskRail automations.",
  "domain": "wordpress",
  "operations": [
    "get",
    "list",
    "create",
    "update",
    "delete"
  ],
  "inputs": {
    "operation": "supported operation",
    "baseUrl": "WordPress site URL",
    "resource": "REST resource path",
    "authorization": "runtime authorization material",
    "payload": "write payload",
    "authorizeMutation": "required true for create/update/delete"
  },
  "outputs": {
    "ok": "boolean",
    "data": "WordPress REST response"
  },
  "components": [
    "http",
    "config",
    "log",
    "retry",
    "timeout"
  ],
  "sideEffects": "mixed network read/write; create/update/delete are mutations",
  "idempotency": "caller",
  "authorization": {
    "mutation": "explicit"
  },
  "status": "active",
  "tests": {
    "required": true,
    "command": "node --test test/*.test.mjs"
  },
  "runtime": "node",
  "canonicalPath": "index.mjs",
  "keywords": [
    "wordpress",
    "wp-rest",
    "posts",
    "pages",
    "media"
  ]
}
